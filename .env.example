# Copia este archivo como .env para desarrollo local. Nunca subas el .env al repositorio.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/employer_buddy

# WhatsApp Cloud API (Meta for Developers > tu app > WhatsApp > Configuración de la API)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0

# Números autorizados, separados por comas, formato internacional sin "+". Ej.: 573001112233
ALLOWED_NUMBERS=
